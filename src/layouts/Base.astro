---
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/source-serif-4/opsz-italic.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import portrait from '../assets/display-picture.jpg';
import { NAV, SITE, SOCIAL } from '../site';

interface Props {
  title?: string;
  description?: string;
  /** Set for blog posts: switches Open Graph type and adds article metadata. */
  article?: { published: Date; modified?: Date };
}

const { title, description = SITE.description, article } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} · ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = await getImage({ src: portrait, width: 1200, height: 1200, fit: 'cover', position: 'top', format: 'jpeg' });
const ogImageUrl = new URL(ogImage.src, Astro.site);
// Link-preview card for LinkedIn, Slack etc. Regenerate with `node scripts/og-card.mjs`.
const cardUrl = new URL('/og-card.jpg', Astro.site);
const path = Astro.url.pathname;

const personId = new URL('/#person', Astro.site).href;
const person = {
  '@type': 'Person',
  '@id': personId,
  name: SITE.author,
  alternateName: SITE.alternateName,
  url: Astro.site?.href,
  image: ogImageUrl.href,
  jobTitle: SITE.jobTitle,
  email: `mailto:${SITE.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Berlin', addressCountry: 'DE' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'National University of Sciences and Technology (NUST)' },
  knowsAbout: ['Kubernetes', 'Terraform', 'Site reliability engineering', 'DevOps', 'Platform engineering', 'AWS', 'Azure', 'AI agent security'],
  sameAs: SOCIAL.filter((s) => s.href.startsWith('http')).map((s) => s.href),
};
const website = {
  '@type': 'WebSite',
  '@id': new URL('/#website', Astro.site).href,
  url: Astro.site?.href,
  name: SITE.title,
  description: SITE.description,
  inLanguage: SITE.locale,
  publisher: { '@id': personId },
};
const page = article
  ? {
      '@type': 'BlogPosting',
      headline: title,
      description,
      datePublished: article.published.toISOString(),
      dateModified: (article.modified ?? article.published).toISOString(),
      author: { '@id': personId },
      publisher: { '@id': personId },
      mainEntityOfPage: canonical.href,
      image: ogImageUrl.href,
      inLanguage: SITE.locale,
    }
  : {
      '@type': path === '/' || path === '/about/' ? 'ProfilePage' : 'WebPage',
      url: canonical.href,
      name: pageTitle,
      description,
      isPartOf: { '@id': website['@id'] },
      ...(path === '/' || path === '/about/' ? { mainEntity: { '@id': personId } } : { about: { '@id': personId } }),
    };
const jsonLd = { '@context': 'https://schema.org', '@graph': [person, website, page] };
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f6f3ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141311" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-96.png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/atom+xml" title={SITE.title} href="/atom.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/markdown" title="Profile for AI agents" href="/llms.txt" />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={cardUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.author}, ${SITE.tagline}`} />
    <meta property="og:locale" content="en_GB" />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article && <meta property="article:author" content={SITE.author} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={cardUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="wordmark" href="/">
          <span class="wordmark-name">Syed Usman</span>
          <span class="wordmark-role">engineer · berlin</span>
        </a>
        <nav aria-label="Main">
          <ul class="nav">
            {
              NAV.map((item) => (
                <li>
                  <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div class="footer-contact">
          <p class="eyebrow">Say hello</p>
          <a class="footer-email" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </div>
        <ul class="footer-links">
          {
            SOCIAL.map((s) => (
              <li>
                <a href={s.href}>{s.label}</a>
              </li>
            ))
          }
        </ul>
        <p class="footer-note">Built with Astro and hosted on GitHub Pages. No cookies or tracking.</p>
      </div>
    </footer>
    <dialog class="lightbox" aria-label="Photo">
      <button class="lightbox-close" type="button" aria-label="Close photo">×</button>
      <figure>
        <img alt="" />
        <figcaption></figcaption>
      </figure>
    </dialog>
    <script>
      // Click a photo to see it large. Uses the biggest file from the image's srcset.
      const dialog = document.querySelector<HTMLDialogElement>('.lightbox')!;
      const big = dialog.querySelector('img')!;
      const caption = dialog.querySelector('figcaption')!;

      const largest = (img: HTMLImageElement) => {
        const candidates = (img.srcset || '')
          .split(',')
          .map((c) => c.trim().split(/\s+/))
          .filter(([url]) => url)
          .map(([url, w]) => ({ url, w: parseInt(w) || 0 }));
        return candidates.sort((a, b) => b.w - a.w)[0]?.url || img.currentSrc || img.src;
      };

      const open = (img: HTMLImageElement) => {
        big.src = largest(img);
        big.alt = img.alt;
        const figure = img.closest('figure');
        const text =
          figure?.querySelector('figcaption')?.textContent ||
          (img.closest('p')?.nextElementSibling?.classList.contains('photo-caption')
            ? img.closest('p')!.nextElementSibling!.textContent
            : '');
        caption.textContent = text?.trim() || '';
        caption.hidden = !caption.textContent;
        dialog.showModal();
      };

      document.querySelectorAll<HTMLImageElement>('.photo img, .role-photos img, .prose img').forEach((img) => {
        img.classList.add('zoomable');
        img.tabIndex = 0;
        img.setAttribute('role', 'button');
        img.setAttribute('aria-label', `Open larger photo: ${img.alt}`);
        img.addEventListener('click', () => open(img));
        img.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            open(img);
          }
        });
      });

      dialog.querySelector('.lightbox-close')!.addEventListener('click', () => dialog.close());
      // Clicking the dark area around the photo closes it too. Escape is handled by <dialog>.
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog || e.target === dialog.querySelector('figure')) dialog.close();
      });
      dialog.addEventListener('close', () => big.removeAttribute('src'));
    </script>
  </body>
</html>
