---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../site';

const posts = await getPosts();
---

<Base title="Writing" description="Posts by Syed Usman about debugging production, Kubernetes, IoT, backups and AI agents.">
  <div class="wrap narrow">
    <header class="page-header">
      <p class="eyebrow">Writing</p>
      <h1>Writing</h1>
      <p class="lead">
        Short write-ups of problems I’ve worked on, what went wrong and how we fixed them. There’s an
        <a href="/atom.xml">Atom feed</a> if you’d like new posts in your reader.
      </p>
    </header>
    <PostList posts={posts} />
  </div>
</Base>
