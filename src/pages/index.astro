---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import portrait from '../assets/display-picture.jpg';
import { SITE, getPosts } from '../site';

const posts = await getPosts();

const numbers = [
  { value: '200/200', label: 'users served in the final load test, up from 15–23% failed logins' },
  { value: '30%+', label: 'lower infrastructure cost after moving a 10,000+ learner platform to autoscaling Kubernetes' },
  { value: '900+', label: 'lifts monitored by Franz, an IoT platform my team took from zero to MVP in under six months' },
  { value: '6–10', label: 'engineers in the cross-functional team I led as tech lead' },
];

const cases = [
  {
    tag: 'Reliability',
    title: 'The 200-user wall',
    problem:
      'A load test stalled at ~170 of 200 users and 15–23% of logins failed, while every application log looked clean.',
    work: 'Ten instrumented runs, one layer ruled out per run, until node autoscaling turned out to be reconfiguring the load balancer mid-test.',
    result: '200/200 users, zero failures, fixed in Terraform and Helm so the next deploy can’t undo it.',
    href: '/2026-10-28/the-200-user-wall/',
    cta: 'Read the write-up',
  },
  {
    tag: 'Recovery',
    title: 'Backups someone has actually restored',
    problem: 'User data lives on Kubernetes volumes, and a backup nobody has restored from is only a hope.',
    work: 'Volume backups, a restore runbook from single file to full environment, and a script that works out the minimal restore chain.',
    result: 'Timed recovery drills on the main databases, so “how long until it’s back?” has a measured answer.',
    href: '/2026-10-29/a-backup-counts-once-restored/',
    cta: 'Read the write-up',
  },
  {
    tag: 'AI guardrails',
    title: 'Letting an AI agent near production, safely',
    problem: 'We wanted Claude to investigate infrastructure issues on its own, without handing it a human’s keys.',
    work: 'A dedicated least-privilege identity with short-lived credentials and audit logs, sandboxed runs, and default-deny tool access instead of an allow-list.',
    result: 'An agent that investigates on its own without anyone’s keys, with every action attributable to it.',
    href: '/2026-10-29/guardrails-for-ai-agents/',
    cta: 'Read the write-up',
  },
  {
    tag: 'IoT',
    title: 'Franz: from zero to 900+ lifts',
    problem: 'An elevator-monitoring product needed hardware, firmware, edge software and cloud, built by one team at once.',
    work: 'Worked with a cross-functional team across frontend, backend, firmware and embedded Linux; built the edge layer and an over-the-air update system myself.',
    result: 'A working MVP in under six months. The platform now monitors 900+ lifts in production.',
    href: '/work/#relayr-senior',
    cta: 'More in my work',
  },
];
---

<Base>
  <section class="wrap hero">
    <div class="hero-text">
      <p class="eyebrow">Infrastructure engineer · Berlin</p>
      <h1>I find out why production broke, fix it in code, and make sure it stays fixed.</h1>
      <p class="lead">
        For a decade I’ve built and run the platforms other engineers build on: from sensors in 900+ elevators to a
        learning platform on Kubernetes for 10,000+ learners. Lately I also build the guardrails that let AI agents work
        on real infrastructure without becoming the next incident. I write here about what broke, what I got wrong, and
        what I’d do again.
      </p>
      <p class="actions">
        <a class="button" href="/2026-10-28/the-200-user-wall/">Read “The 200-user wall”</a>
        <a class="button button-quiet" href="/work/">See my work</a>
      </p>
    </div>
    <figure class="hero-portrait">
      <Image src={portrait} alt="Syed Usman, smiling, on a balcony above Berlin" width={480} height={600} fit="cover" position="top" loading="eager" />
    </figure>
  </section>

  <section class="wrap" aria-labelledby="numbers">
    <h2 id="numbers" class="section-label">By the numbers</h2>
    <ul class="numbers">
      {
        numbers.map((n) => (
          <li>
            <strong>{n.value}</strong>
            <span>{n.label}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap" aria-labelledby="selected">
    <h2 id="selected" class="section-label">Selected work</h2>
    <div class="cases">
      {
        cases.map((c) => (
          <article class="case">
            <p class="case-tag">{c.tag}</p>
            <h3>{c.title}</h3>
            <dl>
              <dt>Problem</dt>
              <dd>{c.problem}</dd>
              <dt>What I did</dt>
              <dd>{c.work}</dd>
              <dt>Result</dt>
              <dd>{c.result}</dd>
            </dl>
            <a class="case-link" href={c.href}>
              {c.cta} <span aria-hidden="true">→</span>
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <section class="wrap" aria-labelledby="writing">
    <div class="narrow">
    <h2 id="writing" class="section-label">Writing</h2>
    <PostList posts={posts.slice(0, 5)} />
    {posts.length > 5 && <p><a class="case-link" href="/writing/">All writing →</a></p>}
    </div>
  </section>

  <section class="wrap" aria-labelledby="hello">
    <div class="narrow cta">
    <h2 id="hello">Building a platform team?</h2>
    <p>
      I like hard reliability problems, teams that write things down, and work where the fix ends up in code instead of
      someone’s memory. If that sounds like your team, I’d like to hear what you’re working on.
    </p>
    <p><a class="button" href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
    </div>
  </section>
</Base>
