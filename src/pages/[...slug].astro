---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { formatDate, getPosts, postSlug, postUrl, type Post } from '../site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: postSlug(post) },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description} article={{ published: post.data.date }}>
  <article class="post prose">
    <header>
      <h1>{post.data.title}</h1>
      <time class="post-date" datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time>
      {post.data.draft && <p class="draft-badge">Draft: not published</p>}
    </header>
    <Content />
  </article>

  {
    (newer || older) && (
      <nav class="pager" aria-label="More posts">
        {older ? (
          <a class="pager-older" href={postUrl(older)}>
            <span>Older</span>
            {older.data.title}
          </a>
        ) : (
          <span />
        )}
        {newer && (
          <a class="pager-newer" href={postUrl(newer)}>
            <span>Newer</span>
            {newer.data.title}
          </a>
        )}
      </nav>
    )
  }
</Base>
