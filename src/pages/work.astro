---
import Base from '../layouts/Base.astro';
import { SITE } from '../site';

const strengths = [
  {
    title: 'Debugging below the application',
    text: 'When the app logs look fine and users still fail, I work down through load balancers, ingress, Kubernetes and the kernel with packet captures and profilers, ruling out one layer at a time.',
  },
  {
    title: 'Platforms that live in code',
    text: 'Terraform, Helm, Ansible and GitOps for clusters, identity, DNS, monitoring and backups, so migrations, upgrades and restores can be repeated rather than remembered.',
  },
  {
    title: 'Leading engineers',
    text: 'Four years as tech lead of 6–10 engineers: hiring, 1:1s and mentoring, planning with clients and stakeholders, and running incidents and on-call.',
  },
];

type Role = {
  id: string;
  company: string;
  url?: string;
  title: string;
  dates: string;
  place: string;
  note?: string;
  items: { lead: string; text: string; link?: { href: string; label: string } }[];
  stack?: string;
};

const roles: Role[] = [
  {
    id: 'multiverse',
    company: 'Multiverse',
    url: 'https://www.multiverse.io',
    title: 'Senior DevOps/Infrastructure Engineer',
    dates: 'Aug 2024 – now',
    place: 'Berlin',
    note: 'Joined StackFuel, which Multiverse acquired in 2025. I run the infrastructure behind hands-on data and coding courses: JupyterHub labs, analytics and identity, on Kubernetes across Hetzner and Scaleway.',
    items: [
      {
        lead: 'Scaled the learner platform to 200 concurrent users.',
        text: 'A JupyterHub load test stalled at ~170 users with 15–23% of logins failing below the application layer. Over ten instrumented runs (Locust, tcpdump, py-spy) I ruled out the hub, auth, ingress, kernel and client, and traced it to node autoscaling reconfiguring the load balancer mid-test. Result: 200/200 servers, zero login or spawn failures, reproduced and codified in Terraform and Helm.',
        link: { href: '/2026-10-28/the-200-user-wall/', label: 'Read the write-up' },
      },
      {
        lead: 'Cut infrastructure cost by more than 30%.',
        text: 'Moved Coding Labs (JupyterHub) and the analytics stack (Airflow, Metabase) from manually managed and on-premise servers to autoscaling Kubernetes, serving 10,000+ learners.',
      },
      {
        lead: 'Made recovery something we rehearse.',
        text: 'Velero and Kopia volume backups with 90-day retention, a restore runbook from single file to full environment, and a script that computes the minimal restore chain across volumes. Drills on the two main databases measured a restore time of 1–4 hours.',
      },
      {
        lead: 'Gave an AI agent its own least-privilege identity.',
        text: 'Short-lived OIDC-federated credentials, network allow-listing and full audit logging, scoped read-only. It runs unattended in Docker sandboxes to investigate and resolve infrastructure issues, isolated from production.',
      },
      {
        lead: 'Co-built an AI-assisted delivery pipeline.',
        text: 'Claude Code takes a Jira ticket to a merge request through competing planners, test-first implementation, review subagents and two human approval gates. I designed its default-deny tool-access hook (an allow-list only skips prompts; it doesn’t block anything) and made it treat ticket text as untrusted input.',
      },
      {
        lead: 'Kept the platform current and declarative.',
        text: 'Upgraded clusters across three environments to Kubernetes 1.35; Keycloak realms (clients, roles, auth flows) and DNS managed in Terraform; n8n deployed with Keycloak SSO and its AI assistant isolated in sysbox-runc sandboxes with no privileged fallback; New Relic agents via Ansible and alerts via Terraform; Renovate across repositories.',
      },
    ],
    stack: 'Kubernetes (Kapsule, Hetzner), Terraform, Helm, Ansible, GitLab CI, Keycloak, Velero, New Relic, Claude Code',
  },
  {
    id: 'jillion',
    company: 'Jillion',
    title: 'Senior Cloud Infrastructure Engineer',
    dates: 'Nov 2023 – Jun 2024',
    place: 'Berlin',
    note: 'Designed the AWS platform: environments, delivery pipelines, Kubernetes and observability.',
    items: [
      {
        lead: 'Staging and production on AWS, entirely in Terraform.',
        text: 'Environments and IAM permissions managed declaratively, with GitOps workflows.',
      },
      {
        lead: 'Self-service for developers.',
        text: 'GitHub Actions pipelines for infrastructure, quality checks (SonarQube), tests and image builds to ECR, with runners on Kubernetes; self-service jobs for provisioning infrastructure, managing secrets and deploying workloads.',
      },
      {
        lead: 'A more resilient EKS.',
        text: 'ArgoCD for deployments; capacity reservations, pod priority classes, eviction policies and admission control to enforce resource requests and limits.',
      },
      {
        lead: 'Observability and access.',
        text: 'OpenTelemetry and Datadog for metrics, traces and logs; Helm charts for Gloo, Oathkeeper and the observability stack; a Pritunl site-to-site VPN with declarative access control.',
      },
    ],
    stack: 'AWS (EKS, ECR, IAM), Terraform, ArgoCD, GitHub Actions, OpenTelemetry, Datadog',
  },
  {
    id: 'relayr',
    company: 'Relayr',
    url: 'https://relayr.io',
    title: 'Tech Lead',
    dates: 'May 2019 – Jun 2023',
    place: 'Berlin',
    note: 'Industrial IoT: sensors, gateways and cloud platforms for elevators, machines, buildings and ships.',
    items: [
      {
        lead: 'Led a cross-functional team of 6–10 engineers.',
        text: 'Hiring and technical interviews, 1:1s and mentoring, sprint and roadmap planning, requirement workshops with clients, and incident response with postmortems and on-call.',
      },
      {
        lead: 'Franz, from zero to 900+ lifts.',
        text: 'Took an elevator-monitoring product to a working MVP in under six months with frontend, backend, firmware and embedded Linux engineers. Built the edge software (Python, MQTT, Buildroot) and an over-the-air update system for the devices.',
      },
      {
        lead: 'Kubernetes and GitOps as the company default.',
        text: 'Led adoption across AWS and Azure for 5+ client platforms, with Terraform and Atlantis so infrastructure changes were reviewed like code.',
      },
      {
        lead: 'Client platforms.',
        text: 'Equipment-as-a-Service clusters on-premise and on EKS with large Azure Postgres; a near-real-time backend for presses and laser cutters (Django monolith to Flask microservices, Prometheus and EFK); monitoring for smart buildings and ships that contributed to a ~12% cut in vessel fuel costs.',
      },
    ],
    stack: 'Kubernetes, AWS, Azure, Terraform, Atlantis, Python, MQTT, Buildroot, Prometheus, Grafana',
  },
  {
    id: 'relayr-solutions',
    company: 'Relayr',
    title: 'Solutions Engineer',
    dates: 'Jul 2018 – Apr 2019',
    place: 'Berlin',
    items: [
      {
        lead: 'Backend for lift monitoring on AWS.',
        text: 'Dockerised microservices on Kubernetes, a Python gateway agent for real-time sensor data, Terraform across dev, staging and production, Prometheus and Grafana alerting, and Jenkins pipelines for services, embedded Linux builds and hardware stress tests. Worked with vendors to industrialise gateways, sensors and firmware.',
      },
    ],
  },
  {
    id: 'colormass',
    company: 'Colormass',
    title: 'Software Engineer',
    dates: 'Jul 2017 – Apr 2018',
    place: 'Berlin',
    items: [
      {
        lead: 'From App Engine to Kubernetes.',
        text: 'Migrated a Django monolith to microservices on Kubernetes with Jenkins CI/CD, and built a render farm on GCP in Python that cut render times by about half.',
      },
    ],
  },
  {
    id: 'yotascale',
    company: 'YotaScale',
    title: 'Software Engineer',
    dates: 'Aug 2015 – Jun 2017',
    place: 'Palo Alto & Lahore',
    items: [
      {
        lead: 'Finding waste in AWS bills.',
        text: 'A cost and utilisation pipeline on Kinesis, Lambda and Redshift, with TypeScript and Flask dashboards to surface anomalies; Jenkins deployments and a Postgres migration from on-premise to RDS.',
      },
    ],
  },
];

const toolbox = [
  ['Cloud', 'AWS, Azure, Hetzner, Scaleway, IONOS'],
  ['Kubernetes', 'Managed and self-run clusters, Helm, Traefik, ArgoCD, Velero'],
  ['Infrastructure as code', 'Terraform, Ansible, Atlantis, GitOps, Renovate'],
  ['CI/CD', 'GitLab CI, GitHub Actions, Jenkins'],
  ['Observability', 'Prometheus, Grafana, New Relic, OpenTelemetry, Datadog, Locust'],
  ['Identity & security', 'Keycloak, OIDC federation, sysbox sandboxes, secrets management'],
  ['AI tooling', 'Claude Code pipelines (skills, subagents, hooks), agent identity and sandboxing'],
  ['Code', 'Python, Bash, SQL; PostgreSQL, Redis, Kafka, MQTT'],
];
---

<Base
  title="Work"
  description="Experience of Syed Usman: Kubernetes platforms, reliability, backup and recovery, AI-agent guardrails, and four years leading an IoT engineering team."
>
  <div class="wrap">
    <header class="page-header narrow">
      <p class="eyebrow">Work</p>
      <h1>A decade of keeping platforms up</h1>
      <p class="lead">
        From AWS cost analytics in Palo Alto to IoT fleets and learning platforms in Berlin. A PDF CV is available on
        request at <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </p>
    </header>

    <ul class="strengths">
      {
        strengths.map((s) => (
          <li>
            <h2>{s.title}</h2>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ul>

    <h2 class="section-label">Experience</h2>
    <ol class="timeline">
      {
        roles.map((role) => (
          <li id={role.id} class="role">
            <div class="role-meta">
              <p>{role.dates}</p>
              <p>{role.place}</p>
            </div>
            <div class="role-body">
              <h3>
                {role.title} <span class="at">at</span> {role.url ? <a href={role.url}>{role.company}</a> : role.company}
              </h3>
              {role.note && <p class="role-note">{role.note}</p>}
              <ul>
                {role.items.map((item) => (
                  <li>
                    <strong>{item.lead}</strong> {item.text}
                    {item.link && (
                      <>
                        {' '}
                        <a href={item.link.href}>{item.link.label} →</a>
                      </>
                    )}
                  </li>
                ))}
              </ul>
              {role.stack && <p class="role-stack">{role.stack}</p>}
            </div>
          </li>
        ))
      }
    </ol>

    <div class="two-col">
      <section aria-labelledby="toolbox">
        <h2 id="toolbox" class="section-label">Toolbox</h2>
        <dl class="toolbox">
          {
            toolbox.map(([k, v]) => (
              <>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </>
            ))
          }
        </dl>
      </section>
      <section aria-labelledby="education">
        <h2 id="education" class="section-label">Education</h2>
        <dl class="toolbox">
          <dt>2011 – 2015</dt>
          <dd>
            BSc Software Engineering, National University of Sciences &amp; Technology (NUST), Islamabad. Gold medallist.
          </dd>
          <dt>2018</dt>
          <dd>AWS Certified Solutions Architect – Associate</dd>
          <dt>Languages</dt>
          <dd>English (native), German (B1, improving)</dd>
        </dl>
      </section>
    </div>
  </div>
</Base>
