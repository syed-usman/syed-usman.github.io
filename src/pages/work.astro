---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { SITE } from '../site';
import relayrSensorInLift from '../assets/work/relayr-sensor-in-lift.jpg';
import liftShaft from '../assets/work/lift-shaft.jpg';
import gatewayEnclosure from '../assets/work/gateway-enclosure.jpg';
import gatewayOnBench from '../assets/work/gateway-on-bench.jpg';
import doorRailSensors from '../assets/work/door-rail-sensors.jpg';
import sensorBoxPrototype from '../assets/work/sensor-box-prototype.jpg';
import officeTeam from '../assets/work/office-team.jpg';
import workshopTeam from '../assets/work/workshop-team.jpg';
import officeDesk from '../assets/work/office-desk.jpg';

const strengths = [
  {
    title: 'Leading engineers',
    text: 'Two years as tech lead of 8 engineers while I was a Solutions Architect. I hired, ran 1:1s, mentored, planned with clients, and handled incidents and on-call.',
  },
  {
    title: 'Debugging below the application',
    text: 'When the app logs look fine and users are still failing, I work my way down through the load balancer, ingress, Kubernetes and the kernel with packet captures and profilers, one layer at a time.',
  },
  {
    title: 'Keeping it all in code',
    text: 'Clusters, identity, DNS, monitoring and backups in Terraform, Helm, Ansible and GitOps, so the next migration, upgrade or restore doesn’t depend on someone remembering how it was done.',
  },
];

type Role = {
  id: string;
  company: string;
  url?: string;
  title: string;
  dates: string;
  place: string;
  note?: string;
  items: string[];
  stack?: string;
  photos?: { src: ImageMetadata; alt: string; caption: string; position?: string }[];
};

const roles: Role[] = [
  {
    id: 'multiverse',
    company: 'Multiverse',
    url: 'https://www.multiverse.io',
    title: 'Senior DevOps/Infrastructure Engineer',
    dates: 'Aug 2024 – now',
    place: 'Berlin',
    note: 'I joined StackFuel, which Multiverse bought in 2025. I run the infrastructure behind hands-on data and coding courses.',
    items: [
      'Got the learner platform to 200 users at once by tracking failing logins down to a problem below the application, then fixing it in code. In the final load test every user got in.',
      'Cut infrastructure cost by more than 30% by moving the lab and analytics platforms from hand-managed servers to autoscaling Kubernetes. It serves more than 10,000 learners.',
      'Set up backups, a restore runbook that covers everything from one file to a whole environment, and recovery drills we actually time.',
      'Gave an AI agent its own identity with as little access as possible, short-lived credentials, audit logs and sandboxed runs, so it can investigate infrastructure problems without anyone’s keys.',
      'Co-built a pipeline that takes a ticket to a merge request with Claude, with people approving at each gate. I designed how it limits which tools the agent can use.',
      'Keep the platform up to date with regular cluster upgrades, and identity, DNS, monitoring and dependency updates managed as code.',
      'Do almost all of this work with AI agents, with skills for anything recurring, including skills that check my merge requests for the things my colleagues usually comment on.',
    ],
  },
  {
    id: 'jillion',
    company: 'Jillion',
    title: 'Senior Cloud Infrastructure Engineer',
    dates: 'Nov 2023 – Jun 2024',
    place: 'Berlin',
    note: 'I designed their AWS platform, from the environments and delivery pipelines to Kubernetes and observability.',
    items: [
      'Built staging and production on AWS entirely in Terraform, with environments and IAM permissions managed through GitOps.',
      'Set up CI/CD for infrastructure, tests and image builds, plus self-service jobs so developers could provision infrastructure, manage secrets and deploy on their own.',
      'Made EKS more resilient with GitOps deployments and scheduling and resource policies, so workloads degrade predictably when the cluster is under pressure.',
      'Added metrics, traces and logs with OpenTelemetry, and moved network access control into code.',
    ],
  },
  {
    id: 'freelance',
    company: 'Freelance',
    title: 'DevOps Engineer',
    dates: 'Jun – Nov 2023',
    place: 'Berlin',
    note: 'Through a contracting agency, for a US dental supplies retailer running a high-volume online store.',
    items: [
      'Built the infrastructure the retailer needed to expand into a new country. Their store runs on Magento Cloud with a lot of other platforms connected to it, and handles hundreds of thousands in revenue a day.',
    ],
  },
  {
    id: 'relayr',
    company: 'Munich Re (relayr)',
    title: 'Solutions Architect',
    dates: 'May 2021 – Jun 2023',
    place: 'Berlin',
    note: 'relayr was Munich Re’s industrial IoT company in Berlin. We built sensors, gateways and cloud platforms for lifts, machines, buildings and ships.',
    items: [
      'Tech lead of a team of 8 engineers across disciplines: hiring and interviews, 1:1s and mentoring, sprint and roadmap planning, workshops with clients, and incidents and on-call.',
      'Led the move to Kubernetes and GitOps as the default across AWS and Azure for more than five client platforms, using Terraform and Atlantis so infrastructure changes got reviewed like code.',
      'Built platforms for industrial machines, smart buildings and ships, on-premise and on AWS and Azure. The ship monitoring helped cut a client’s vessel fuel costs by about 12%.',
    ],
  },
  {
    id: 'relayr-senior',
    company: 'Munich Re (relayr)',
    title: 'Senior Solutions Engineer',
    dates: 'May 2019 – Apr 2021',
    place: 'Berlin',
    photos: [
      { src: relayrSensorInLift, alt: 'A white relayr-branded sensor mounted in the corner of a lift car', caption: 'A relayr sensor in a lift car, 2019' },
      { src: doorRailSensors, alt: 'Red sensors mounted on a lift door rail', caption: 'Sensors on a lift door rail, 2019' },
      { src: gatewayOnBench, alt: 'Open grey enclosure with a single-board computer and backup battery, tools on the desk around it', caption: 'Assembling a gateway, 2019' },
      { src: sensorBoxPrototype, alt: 'Prototype board with sensors and jumper wires mounted on a clear plate', caption: 'Prototyping a sensor box, 2020' },
      { src: officeDesk, alt: 'Syed working at a desk in the office, with boxes of hardware on the desk in front', caption: 'Hardware day at the office, 2020', position: '0% center' },
      { src: workshopTeam, alt: 'Syed with four teammates in front of a retrospective board and a video call screen; teammates\' faces blurred', caption: 'Team retro, 2020 (teammates blurred)', position: '36% center' },
    ],
    items: [
      'Took Franz, a lift-monitoring product, from nothing to a working MVP in under six months with frontend, backend, firmware and embedded Linux engineers. I built the edge software (Python, MQTT, Buildroot) and the over-the-air updates. Franz now monitors more than 900 lifts.',
    ],
  },
  {
    id: 'relayr-solutions',
    company: 'Munich Re (relayr)',
    title: 'Solutions Engineer',
    dates: 'Jul 2018 – Apr 2019',
    place: 'Berlin',
    photos: [
      { src: officeTeam, alt: 'Selfie of Syed in the relayr office with teammates at their desks behind him; teammates\' faces blurred', caption: 'The relayr office, 2018 (teammates blurred)', position: '42% center' },
      { src: gatewayEnclosure, alt: 'Open gateway enclosure with an interface board, cellular modem and power supply, connected to a debugger', caption: 'Edge gateway on the debugger, 2019' },
      { src: liftShaft, alt: 'Looking down a lift shaft at a sensor mounted on the car', caption: 'Installing in a lift shaft, 2019' },
    ],
    items: [
      'Built the backend for lift monitoring on AWS: microservices on Kubernetes, a gateway agent for real-time sensor data, and infrastructure as code. Set up CI for the services, embedded Linux builds and hardware stress tests, and helped vendors get gateways, sensors and firmware ready for production.',
    ],
  },
  {
    id: 'colormass',
    company: 'Colormass',
    title: 'Software Engineer',
    dates: 'Jul 2017 – Apr 2018',
    place: 'Berlin',
    items: [
      'Built a 3D scene editor in the browser with three.js. Clients set up their scenes and camera angles in it, and our 3D designers used that to make the final renders in 3ds Max.',
      'Ported Google’s Draco geometry compression from C++ to JavaScript, so the editor could compress and decompress heavy 3D models in the browser. A lot of the C++ wasn’t well documented, so much of the work was figuring out what it actually did.',
      'Moved a Django monolith from App Engine to microservices on Kubernetes with Jenkins CI/CD, and built a render farm on GCP in Python that cut render times roughly in half.',
    ],
  },
  {
    id: 'yotascale',
    company: 'YotaScale',
    title: 'Software Engineer',
    dates: 'Aug 2015 – Jun 2017',
    place: 'Palo Alto & Lahore',
    items: [
      'Worked on a pipeline that dug through AWS bills for waste (Kinesis, Lambda, Redshift), with dashboards that flagged anomalies. Also ran Jenkins deployments and moved Postgres from on-premise to RDS.',
    ],
  },
];

const glance = [
  { year: '2015', where: 'YotaScale', what: 'AWS cost analytics' },
  { year: '2017', where: 'Colormass', what: '3D editor in the browser, first Kubernetes' },
  { year: '2018', where: 'relayr (Munich Re)', what: 'Industrial IoT, then tech lead of 8' },
  { year: '2023', where: 'Freelance', what: 'E-commerce infrastructure' },
  { year: '2023', where: 'Jillion', what: 'AWS platform from scratch' },
  { year: '2024', where: 'Multiverse', what: 'Kubernetes platform, built with AI agents' },
];

const toolbox = [
  ['Cloud', 'AWS, Azure, Hetzner, Scaleway, IONOS'],
  ['Kubernetes', 'Managed and self-run clusters, Helm, Traefik, ArgoCD, Velero'],
  ['Infrastructure as code', 'Terraform, Ansible, Atlantis, GitOps, Renovate'],
  ['CI/CD', 'GitLab CI, GitHub Actions, Jenkins'],
  ['Observability', 'Prometheus, Grafana, New Relic, OpenTelemetry, Datadog, Locust'],
  ['Identity & security', 'Keycloak, OIDC federation, sysbox sandboxes, secrets management'],
  ['AI', 'Claude Code: skills, subagents and hooks, our own harness, the BMAD Method; agent identity and sandboxing'],
  ['Code', 'Python, Bash, SQL; PostgreSQL, Redis, Kafka, MQTT'],
];
---

<Base
  title="Work"
  description="Experience of Syed Usman: Kubernetes platforms, reliability, backup and recovery, AI-agent guardrails, and two years as tech lead of an IoT engineering team."
>
  <div class="wrap">
    <header class="page-header narrow">
      <p class="eyebrow">Work</p>
      <h1>Work</h1>
      <p class="lead">
        About a decade, starting with AWS cost analytics in Palo Alto and Lahore, then IoT and learning platforms in
        Berlin. You can <a href="/syed-usman-cv.pdf">download my CV as a PDF</a>, or email me at
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </p>
    </header>

    <ol class="glance" aria-label="Career at a glance">
      {
        glance.map((g) => (
          <li>
            <span class="glance-year">{g.year}</span>
            <strong>{g.where}</strong>
            <span>{g.what}</span>
          </li>
        ))
      }
    </ol>

    <ul class="strengths">
      {
        strengths.map((s) => (
          <li>
            <h2>{s.title}</h2>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ul>

    <h2 class="section-label">Experience</h2>
    <ol class="timeline">
      {
        roles.map((role) => (
          <li id={role.id} class="role">
            <div class="role-meta">
              <p>{role.dates}</p>
              <p>{role.place}</p>
            </div>
            <div class="role-body">
              <h3>
                {role.title} <span class="at">at</span> {role.url ? <a href={role.url}>{role.company}</a> : role.company}
              </h3>
              {role.note && <p class="role-note">{role.note}</p>}
              <ul>
                {role.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              {role.stack && <p class="role-stack">{role.stack}</p>}
              {role.photos && (
                <div class="role-photos">
                  {role.photos.map((photo) => (
                    <figure>
                      <Image
                        src={photo.src}
                        alt={photo.alt}
                        widths={[360, 720, 1440]}
                        sizes="(max-width: 34rem) 45vw, 14rem"
                        style={photo.position && `object-position: ${photo.position}`}
                      />
                      <figcaption>{photo.caption}</figcaption>
                    </figure>
                  ))}
                </div>
              )}
            </div>
          </li>
        ))
      }
    </ol>

    <div class="two-col">
      <section aria-labelledby="toolbox">
        <h2 id="toolbox" class="section-label">Toolbox</h2>
        <dl class="toolbox">
          {
            toolbox.map(([k, v]) => (
              <>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </>
            ))
          }
        </dl>
      </section>
      <section aria-labelledby="education">
        <h2 id="education" class="section-label">Education</h2>
        <dl class="toolbox">
          <dt>2011 – 2015</dt>
          <dd>
            BSc Software Engineering, National University of Sciences &amp; Technology (NUST), Islamabad. Gold medallist.
          </dd>
          <dt>2018</dt>
          <dd>AWS Certified Solutions Architect – Associate</dd>
          <dt>Languages</dt>
          <dd>English (native), German (B1, improving)</dd>
        </dl>
      </section>
    </div>
  </div>
</Base>
