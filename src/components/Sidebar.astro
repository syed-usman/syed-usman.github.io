---
import { Image } from 'astro:assets';
import portrait from '../assets/display-picture.jpg';
import { NAV, SITE, SOCIAL } from '../site';

const current = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---

<header class="sidebar">
  <div class="sidebar-inner">
    <a class="site-identity" href="/">
      <Image
        src={portrait}
        alt=""
        width={96}
        height={96}
        densities={[1, 2]}
        fit="cover"
        position="top"
        class="avatar"
        loading="eager"
      />
      <span class="site-title">{SITE.title}</span>
    </a>
    <p class="lead">{SITE.description}</p>

    <nav aria-label="Main">
      <ul class="nav">
        {
          NAV.map(({ href, label }) => (
            <li>
              <a href={href} aria-current={isActive(href) ? 'page' : undefined}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ul class="social" aria-label="Elsewhere">
      {
        SOCIAL.map(({ href, label }) => (
          <li>
            <a href={href} rel="me">
              {label}
            </a>
          </li>
        ))
      }
    </ul>

    <p class="copyright">© {new Date().getFullYear()} {SITE.author}</p>
  </div>
</header>
